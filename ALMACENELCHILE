    <span class="text-2xl">🛒</span>
    <span id="cart-badge" class="absolute -top-1 -right-1 bg-amber-400 text-gray-900 text-xs font-black w-6 h-6 rounded-full flex items-center justify-center shadow hidden">0</span>
  </button>

  <!-- PANEL LATERAL DEL CARRITO -->
  <aside id="cart-panel" class="fixed right-0 top-0 h-full w-80 md:w-96 bg-white shadow-2xl p-6 overflow-y-auto transform translate-x-full transition-transform duration-300 z-50 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-gray-100">
        <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
          <span>🛒</span> Tu Pedido
        </h2>
        <button id="close-cart" class="text-gray-400 hover:text-red-600 text-2xl font-bold transition" aria-label="Cerrar carrito">✕</button>
      </div>

      <ul id="cart-items" class="mt-4 divide-y divide-gray-100 max-h-[60vh] overflow-y-auto pr-1">
        <p id="empty-cart-msg" class="text-center text-gray-400 py-8 text-sm">Tu carrito está vacío.<br>¡Agregá tus productos favoritos!</p>
      </ul>
    </div>

    <div class="pt-4 border-t border-gray-100 mt-auto">
      <div class="flex justify-between items-center mb-4">
        <span class="text-gray-600 font-semibold text-lg">Total estimado:</span>
        <span class="text-2xl font-black text-red-600">$<span id="cart-total">0</span></span>
      </div>

      <a id="whatsapp-checkout" href="https://wa.me/541138886156" target="_blank" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-4 rounded-xl shadow-lg text-center flex items-center justify-center gap-2 transition">
        <span>📲 Enviar Pedido por WhatsApp</span>
      </a>
    </div>
  </aside>

  <!-- NOTIFICACIÓN DE PRODUCTO AGREGADO -->
  <div id="notification">
    ✨ ¡Agregado al carrito!
  </div>

  <script>
    // --- LÓGICA DEL CARRITO (APERTURA Y CIERRE) ---
    const toggleButton = document.getElementById("toggle-cart");
    const cartPanel = document.getElementById("cart-panel");
    const closeButton = document.getElementById("close-cart");

    toggleButton.addEventListener("click", () => {
      cartPanel.classList.toggle("translate-x-full");
    });

    closeButton.addEventListener("click", () => {
      cartPanel.classList.add("translate-x-full");
    });

    // --- LÓGICA DEL CARRITO (AÑADIR, QUITAR, ACTUALIZAR) ---
    const cart = [];

    function showNotification() {
      const notification = document.getElementById("notification");
      notification.classList.add("show");
      setTimeout(() => {
        notification.classList.remove("show");
      }, 2000);
    }

    function addToCart(product, price) {
      const item = cart.find(i => i.product === product);
      if (item) {
        item.quantity += 1;
      } else {
        cart.push({ product, price, quantity: 1 });
      }
      renderCart();
      showNotification();
    }

    function renderCart() {
      const list = document.getElementById("cart-items");
      const totalEl = document.getElementById("cart-total");
      const emptyMsg = document.getElementById("empty-cart-msg");
      const badge = document.getElementById("cart-badge");

      list.innerHTML = "";
      let total = 0;
      let totalCount = 0;

      if (cart.length === 0) {
        list.innerHTML = `<p class="text-center text-gray-400 py-8 text-sm">Tu carrito está vacío.<br>¡Agregá tus productos favoritos!</p>`;
        badge.classList.add("hidden");
      } else {
        badge.classList.remove("hidden");
        cart.forEach((item, idx) => {
          const subtotal = item.price * item.quantity;
          total += subtotal;
          totalCount += item.quantity;

          const li = document.createElement("li");
          li.className = "py-3 flex flex-col gap-1";
          li.innerHTML = `
            <div class="flex justify-between items-start">
              <span class="font-bold text-sm text-gray-800">${item.product}</span>
              <button class="text-red-500 hover:text-red-700 text-xs font-bold" title="Quitar" onclick="removeItem(${idx})">✕</button>
            </div>
            <div class="flex justify-between items-center mt-1">
              <div class="flex items-center gap-2 border border-gray-200 rounded-lg px-2 py-0.5 bg-gray-50">
                <button class="text-gray-600 font-bold px-1 hover:text-red-600 text-sm" onclick="decrease(${idx})">-</button>
                <span class="text-xs font-extrabold text-gray-800 w-4 text-center">${item.quantity}</span>
                <button class="text-gray-600 font-bold px-1 hover:text-green-600 text-sm" onclick="increase(${idx})">+</button>
              </div>
              <span class="text-sm font-black text-gray-900">$${subtotal.toLocaleString('es-AR')}</span>
            </div>
          `;
          list.appendChild(li);
        });
      }

      badge.textContent = totalCount;
      totalEl.textContent = total.toLocaleString('es-AR');

      // WhatsApp link generator
      const wa = document.getElementById("whatsapp-checkout");
      let msg = "🛒 *NUEVO PEDIDO - ALMACÉN EL CHILE*\n\n";
      
      if (cart.length > 0) {
        cart.forEach(i => {
          msg += `• x${i.quantity} ${i.product} — $${(i.price * i.quantity).toLocaleString('es-AR')}\n`;
        });
        msg += `\n💵 *TOTAL ESTIMADO:* $${total.toLocaleString('es-AR')}\n\n¡Hola! Quisiera realizar este pedido.`;
      } else {
        msg += "Hola Almacén El Chile, quisiera realizar una consulta.";
      }

      wa.href = `https://wa.me/541138886156?text=${encodeURIComponent(msg)}`;
    }

    function increase(index) {
      cart[index].quantity += 1;
      renderCart();
    }

    function decrease(index) {
      if (cart[index].quantity > 1) {
        cart[index].quantity -= 1;
      } else {
        cart.splice(index, 1);
      }
      renderCart();
    }

    function removeItem(index) {
      cart.splice(index, 1);
      renderCart();
    }

    // --- LÓGICA DE PESTAÑAS (TABS) ---
    function showTab(id, btnElement) {
      document.querySelectorAll(".tab-content").forEach(el => el.classList.add("hidden"));
      document.getElementById(id).classList.remove("hidden");

      document.querySelectorAll(".tab-btn").forEach(btn => {
        btn.classList.remove("active-tab");
      });
      btnElement.classList.add("active-tab");
    }

    // --- LÓGICA DEL CARRUSEL NOSOTROS ---
    (function () {
      const slides = document.querySelectorAll('#nosotros-slides .nosotros-slide');
      let i = 0;

      function showSlide(index) {
        slides.forEach((slide, k) => {
          if (k === index) {
            slide.classList.remove('hidden');
          } else {
            slide.classList.add('hidden');
          }
        });
      }

      showSlide(i);

      let slideInterval = setInterval(() => {
        i = (i + 1) % slides.length;
        showSlide(i);
      }, 4000);

      document.getElementById("prev-slide").addEventListener("click", () => {
        clearInterval(slideInterval);
        i = (i - 1 + slides.length) % slides.length;
        showSlide(i);
      });

      document.getElementById("next-slide").addEventListener("click", () => {
        clearInterval(slideInterval);
        i = (i + 1) % slides.length;
        showSlide(i);
      });
    })();

    // --- LÓGICA DE TARJETAS GIRATORIAS (FLIP CARDS) ---
    document.querySelectorAll('.flip-card').forEach(card => {
      card.addEventListener('click', (event) => {
        // Prevenir rotación si se hace click en botones
        if (event.target.tagName.toLowerCase() !== 'button') {
          card.querySelector('.flip-card-inner').classList.toggle('is-flipped');
        }
      });
    });
  </script>

</body>

</html>
